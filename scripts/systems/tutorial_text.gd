extends RefCounted

# Native-sized game onboarding copy. A fallback is intentional if a locale is
# missing any key, and native-language review remains a release gate.
const KEYS := ["rescue_intro","rescue_1","rescue_2","rescue_3","water_intro","water_1","water_2","water_3","block_intro","block_1","block_2","block_3","practice_rescue","practice_water","practice_block","practice_success","practice_blocked","practice_selected","practice_colour_mismatch","practice_water_start","practice_block_hold","practice_block_first","practice_block_missed"]
const COPY := {
    "en": ["Free the chick by opening a route to the edge.","Tap an arrow only when its path to the edge is clear.","Clear a blocker first. Wrong taps can cost a life.","Watch special arrows and gates. Free the rescue lane.","Sort the liquids so each full tube has one colour.","Tap a source tube, then a matching or empty tube.","Pour onto the same colour, or into an empty tube.","Keep an empty tube free. UNDO or HINT can help.","Place shapes, clear rows or columns, and save space.","Touch and hold a shape to lift it above the board.","Drag to valid cells and release to place the shape.","Plan all three pieces. Keep long rows available.","Try: tap the free right-facing arrow.","Try: tap PINK, then matching PINK.","Try: drag blue blocks to the outline.","NICE MOVE! You're ready to play.","Blocked! Find a clear path to the edge.","Pink selected. Now tap the matching tube.","Different colours cannot stack. Try pink.","Tap the left pink tube first.","Keep holding. Drag onto the outline.","Hold the blue piece first.","Almost! Release inside the outline."],
    "es": ["Libera al pollito abriendo un camino hasta el borde.","Toca la flecha solo si su camino al borde está libre.","Quita primero un obstáculo. Los toques erróneos restan vidas.","Observa flechas especiales y puertas. Despeja la salida.","Ordena los líquidos: cada tubo lleno debe tener un solo color.","Toca el tubo de origen y luego uno vacío o del mismo color.","Vierte sobre el mismo color o en un tubo vacío.","Deja un tubo vacío. DESHACER o PISTA pueden ayudarte.","Coloca figuras, borra filas o columnas y conserva espacio.","Mantén pulsada una figura para levantarla del tablero.","Arrastra hasta casillas válidas y suelta para colocarla.","Planifica las tres piezas. Deja filas largas libres.","Prueba: toca la flecha libre que apunta a la derecha.","Prueba: toca ROSA y luego ROSA.","Prueba: arrastra los bloques azules al contorno.","¡BIEN HECHO! Ya puedes jugar.","¡Bloqueada! Busca un camino libre hasta el borde.","Rosa seleccionada. Toca el tubo del mismo color.","No mezcles colores. Prueba con rosa.","Primero toca el tubo rosa de la izquierda.","Mantén pulsado. Arrastra hasta el contorno.","Primero mantén pulsada la pieza azul.","¡Casi! Suelta dentro del contorno."],
    "fr": ["Libère le poussin en ouvrant un chemin vers le bord.","Touche une flèche si son chemin vers le bord est dégagé.","Enlève d'abord un obstacle. Un faux geste coûte une vie.","Observe les flèches et portes spéciales. Dégage la sortie.","Trie les liquides : chaque tube plein doit avoir une couleur.","Touche un tube, puis un tube vide ou de même couleur.","Verse sur la même couleur ou dans un tube vide.","Garde un tube vide. ANNULER ou INDICE peut aider.","Place les formes, efface les lignes et garde de la place.","Maintiens une forme appuyée pour la soulever.","Glisse-la sur des cases libres, puis relâche.","Prévois les trois pièces. Garde des lignes libres.","Essaie : touche la flèche libre vers la droite.","Essaie : touche ROSE, puis ROSE.","Essaie : glisse les blocs bleus sur le contour.","BIEN JOUÉ ! Tu peux commencer.","Bloqué ! Cherche un chemin libre vers le bord.","Rose choisi. Touche le tube de même couleur.","Ne mélange pas les couleurs. Essaie le rose.","Touche d'abord le tube rose de gauche.","Maintiens et glisse sur le contour.","Maintiens d'abord la pièce bleue.","Presque ! Relâche dans le contour."],
    # ADD_SUPPORTED_LANGUAGES
}

static func tr(key: String) -> String:
    var idx := KEYS.find(key)
    if idx < 0: return key
    var tree := Engine.get_main_loop() as SceneTree
    var manager := tree.root.get_node_or_null("LocalizationManager") if tree != null else null
    var locale := String(manager.get("language_code")) if manager != null else "en"
    var fallback: Array = COPY["en"]
    var values: Array = COPY.get(locale,fallback)
    return String(values[idx]) if values.size() == KEYS.size() else String(fallback[idx])
