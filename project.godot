; Engine configuration file.
; Unjam: Rescue Rush
config_version=5

[application]
config/name="Unjam: Rescue Rush"
run/main_scene="res://scenes/Main.tscn"
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)

[autoload]
SaveManager="*res://scripts/core/save_manager.gd"
LevelManager="*res://scripts/core/level_manager.gd"
AdManager="*res://scripts/systems/ad_manager.gd"
AnalyticsManager="*res://scripts/systems/analytics_manager.gd"
DailyChallenge="*res://scripts/systems/daily_challenge.gd"
FeedbackManager="*res://scripts/systems/feedback_manager.gd"
PremiumVisuals="*res://scripts/systems/premium_visuals.gd"
RetentionManager="*res://scripts/systems/retention_manager.gd"
LiveHubLauncher="*res://scripts/systems/live_hub_launcher.gd"
